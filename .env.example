# Salin menjadi .env.local lalu isi dari Supabase Dashboard → Project Settings → API
# HANYA anon/publishable key. JANGAN PERNAH menaruh service_role key di sini.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Domain email internal untuk login berbasis username (NISN/NIP).
# Harus SAMA dengan secret LOGIN_EMAIL_DOMAIN pada Edge Function admin-users.
VITE_LOGIN_EMAIL_DOMAIN=lms.smpn1baradatu.sch.id
